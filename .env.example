# Copy to .env.local and fill in real values. Never commit .env or .env.local.
# NEXT_PUBLIC_* are exposed to the browser.

# Example (add when needed):
# NEXT_PUBLIC_API_URL=https://api.example.com
# API_SECRET=your-secret-here
# Chatbot: якщо задано GEMINI_API_KEY — використовується Google Gemini (пріоритет).
# Інакше — Kimi. Отримати ключ Gemini: https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-gemini-key
# GEMINI_MODEL=gemini-2.0-flash

# Chatbot (fallback): ключ Kimi. Ключ sk-kimi-... → api.kimi.com/coding. Інший → api.moonshot.ai.
# KIMI_API_KEY=sk-kimi-xxx
# KIMI_API_BASE=https://...

# SalesDrive (оформлення замовлень). У Vercel: Settings → Environment Variables.
# SALESDRIVE_DOMAIN=losso.salesdrive.me
# SALESDRIVE_API_KEY=ваш_form_api_key
# SALESDRIVE_FORM_KEY=ваш_form_key

# Нова Пошта (пошук міст/відділень). Ключ: developers.novaposhta.ua
# NOVAPOSHTA_API_KEY=ваш_ключ_нп

# Для аналітики замовлень у CRM
# NEXT_PUBLIC_SITE_NAME=losso-lemon.vercel.app
