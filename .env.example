# Copy to .env.local and fill in real values. Never commit .env or .env.local.
# NEXT_PUBLIC_* are exposed to the browser.

# Example (add when needed):
# NEXT_PUBLIC_API_URL=https://api.example.com
# API_SECRET=your-secret-here
# Chatbot (Kimi Kode 2.5): key from https://platform.moonshot.ai (Moonshot). Without it, chat shows contact fallback.
# KIMI_API_KEY=sk-kimi-your-key
