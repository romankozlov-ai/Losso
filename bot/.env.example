# LOSSO Shop Bot Configuration
# ⚠️ NEVER commit the real .env file! Copy this to .env and fill in your values

# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=your_bot_token_here

# Channel & Bot Settings
CHANNEL_ID=@your_channel
CHANNEL_USERNAME=your_channel_username
BOT_USERNAME=@your_bot_username

# Payment Settings
FOP_CARD_NUMBER=your_card_number
FOP_NAME=Your Name

# Admin Settings
ADMIN_CHAT_ID=your_telegram_chat_id

# SalesDrive API (optional)
SALESDRIVE_API_KEY=
SALESDRIVE_DOMAIN=

# Nova Poshta API (optional)
NOVA_POSHTA_API_KEY=

# Gemini API (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Bot Settings
NODE_ENV=production
LOG_LEVEL=info
